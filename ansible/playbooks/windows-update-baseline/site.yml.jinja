---
- name: Windows update baseline for {{ project_name }}
  hosts: windows
  gather_facts: false
  tasks:
    - name: Search for pending security updates
      ansible.windows.win_updates:
        category_names:
          - SecurityUpdates
        state: searched
      register: update_scan

    - name: Report pending update count
      ansible.builtin.debug:
        msg: "Pending security updates: {{ update_scan.found_update_count | default(0) }}"
