{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repave.dev/schemas/bundle.schema.json",
  "title": "Repave Bundle",
  "description": "Composite golden path: shared inputs and member blueprints rendered together.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "repave.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "Bundle"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["inputs", "members"],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputField"
          }
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "blueprint", "input_mapping"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "blueprint": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "input_mapping": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "inputField": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["string", "boolean", "integer"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "multi": {
          "type": "boolean",
          "description": "When true with enum, value is a comma-separated list of enum items."
        }
      }
    }
  }
}
