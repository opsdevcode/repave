{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repave.dev/schemas/golden-path-artifact.schema.json",
  "title": "Repave Golden Path Artifact",
  "description": "Provenance metadata written to repave.yaml in generated repositories.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "repave.dev/v1beta1"
    },
    "kind": {
      "type": "string",
      "const": "GoldenPathArtifact"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["artifactType", "blueprint", "standard", "generation"],
      "additionalProperties": false,
      "properties": {
        "artifactType": {
          "type": "string",
          "enum": ["terraform-module", "terraform-environment-stack", "ansible-role", "ansible-playbook-project"]
        },
        "blueprint": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "standard": {
          "type": "object",
          "required": ["source", "version"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "generation": {
          "type": "object",
          "required": ["engine_version", "generated_at"],
          "additionalProperties": false,
          "properties": {
            "engine_version": { "type": "string" },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "terraformModule": {
          "type": "object",
          "required": ["module_name", "cloud_provider"],
          "additionalProperties": false,
          "properties": {
            "module_name": { "type": "string" },
            "cloud_provider": { "type": "string" },
            "provider_services": {
              "type": "array",
              "items": { "type": "string" }
            },
            "provider_service": {
              "type": "string",
              "minLength": 1,
              "description": "Single-resource layout: one provider service from the catalog."
            },
            "provider_resource": {
              "type": "string",
              "minLength": 1,
              "description": "Single-resource layout: one resource type within provider_service."
            }
          }
        },
        "terraformEnvironmentStack": {
          "type": "object",
          "required": ["stack_name", "cloud_provider", "environment", "pinned_modules"],
          "additionalProperties": false,
          "properties": {
            "stack_name": { "type": "string", "minLength": 1 },
            "cloud_provider": { "type": "string" },
            "environment": { "type": "string" },
            "pinned_modules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "source"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "source": { "type": "string", "minLength": 1 },
                  "version": { "type": "string" },
                  "repo_name": { "type": "string" }
                }
              }
            }
          }
        },
        "ansibleRole": {
          "type": "object",
          "required": ["role_name", "namespace"],
          "additionalProperties": false,
          "properties": {
            "role_name": { "type": "string" },
            "namespace": { "type": "string" },
            "min_ansible_version": { "type": "string" },
            "target_platforms": { "type": "string" }
          }
        },
        "ansiblePlaybookProject": {
          "type": "object",
          "required": ["project_name", "environment"],
          "additionalProperties": false,
          "properties": {
            "project_name": { "type": "string", "minLength": 1 },
            "environment": { "type": "string" },
            "min_ansible_version": { "type": "string" },
            "pinned_roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["galaxy_name", "version", "src"],
                "additionalProperties": false,
                "properties": {
                  "galaxy_name": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "src": { "type": "string", "minLength": 1 },
                  "repo_name": { "type": "string" }
                }
              }
            }
          }
        },
        "checkov": {
          "type": "object",
          "required": ["policies_source", "policy_version"],
          "additionalProperties": false,
          "properties": {
            "policies_source": { "type": "string" },
            "policy_version": { "type": "string" }
          }
        },
        "ansibleLint": {
          "type": "object",
          "required": ["pack_source", "pack_version"],
          "additionalProperties": false,
          "properties": {
            "pack_source": { "type": "string" },
            "pack_version": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifactType": { "const": "terraform-module" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["terraformModule"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "terraform-environment-stack" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["terraformEnvironmentStack"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "ansible-playbook-project" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["ansiblePlaybookProject"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "ansible-role" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["ansibleRole"]
          }
        }
      ]
    }
  }
}
