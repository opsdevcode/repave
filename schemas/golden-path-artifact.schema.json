{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repave.dev/schemas/golden-path-artifact.schema.json",
  "title": "Repave Golden Path Artifact",
  "description": "Provenance metadata written to repave.yaml in generated repositories.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "repave.dev/v1beta1"
    },
    "kind": {
      "type": "string",
      "const": "GoldenPathArtifact"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["artifactType", "blueprint", "standard", "generation", "governance"],
      "additionalProperties": false,
      "properties": {
        "artifactType": {
          "type": "string",
          "enum": [
            "terraform-module",
            "terraform-environment-stack",
            "ansible-role",
            "ansible-playbook-project",
            "ansible-collection",
            "checkov-policy",
            "opa-policy",
            "azure-policy",
            "observability",
            "helm-chart",
            "app-service",
            "gitops-deployment",
            "github-repo",
            "api-contract",
            "db-migration"
          ]
        },
        "blueprint": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "standard": {
          "type": "object",
          "required": ["source", "version"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "generation": {
          "type": "object",
          "required": ["engine_version", "generated_at"],
          "additionalProperties": false,
          "properties": {
            "engine_version": { "type": "string" },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "governance": {
          "type": "object",
          "required": ["baseline_source", "baseline_version"],
          "additionalProperties": false,
          "properties": {
            "baseline_source": { "type": "string" },
            "baseline_version": { "type": "string" }
          }
        },
        "import": {
          "type": "object",
          "description": "Present when the repository was adopted by repave import rather than generated. The pre-import layout hash is the drift baseline for the original tree.",
          "required": ["source", "imported_at", "pre_import_layout_hash"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string" },
            "imported_at": {
              "type": "string",
              "format": "date-time"
            },
            "pre_import_layout_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "moved_files": {
              "type": "integer",
              "minimum": 0
            },
            "scaffold_files": {
              "type": "integer",
              "minimum": 0
            },
            "unmapped_files": {
              "type": "array",
              "items": { "type": "string" }
            },
            "overrides": {
              "type": "object",
              "description": "Per-file destination overrides applied at import time (source path to destination, keep-in-place, or quarantine).",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "components": {
          "type": "array",
          "description": "Additional golden-path artifacts layered onto this repository via repave add.",
          "items": {
            "type": "object",
            "required": ["id", "artifactType", "blueprint", "standard", "generation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "artifactType": {
                "type": "string",
                "enum": [
                  "terraform-module",
                  "terraform-environment-stack",
                  "ansible-role",
                  "ansible-playbook-project",
                  "ansible-collection",
                  "checkov-policy",
                  "opa-policy",
                  "azure-policy",
                  "observability",
                  "helm-chart",
                  "app-service",
                  "gitops-deployment",
                  "github-repo",
                  "api-contract",
                  "db-migration"
                ]
              },
              "blueprint": {
                "type": "object",
                "required": ["name", "version"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" }
                }
              },
              "standard": {
                "type": "object",
                "required": ["source", "version"],
                "additionalProperties": false,
                "properties": {
                  "source": { "type": "string" },
                  "version": { "type": "string" }
                }
              },
              "generation": {
                "type": "object",
                "required": ["engine_version", "generated_at"],
                "additionalProperties": false,
                "properties": {
                  "engine_version": { "type": "string" },
                  "generated_at": { "type": "string", "format": "date-time" }
                }
              },
              "addedAt": { "type": "string", "format": "date-time" },
              "policy": {
                "type": "object",
                "required": ["profile", "pack_source", "enabled_rules"],
                "additionalProperties": false,
                "properties": {
                  "profile": { "type": "string" },
                  "pack_source": { "type": "string" },
                  "enabled_rules": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "helmChart": {
                "type": "object",
                "required": [
                  "chart_name",
                  "app_name",
                  "image_repository",
                  "image_tag",
                  "service_type",
                  "enable_ingress"
                ],
                "additionalProperties": false,
                "properties": {
                  "chart_name": { "type": "string", "minLength": 1 },
                  "app_name": { "type": "string", "minLength": 1 },
                  "image_repository": { "type": "string", "minLength": 1 },
                  "image_tag": { "type": "string" },
                  "service_type": { "type": "string" },
                  "enable_ingress": { "type": "string" },
                  "ingress_host": { "type": "string" }
                }
              },
              "apiContract": {
                "type": "object",
                "required": [
                  "spec_name",
                  "organization",
                  "spec_kind",
                  "api_title",
                  "api_version"
                ],
                "additionalProperties": false,
                "properties": {
                  "spec_name": { "type": "string", "minLength": 1 },
                  "organization": { "type": "string" },
                  "spec_kind": { "type": "string", "enum": ["openapi", "asyncapi"] },
                  "api_title": { "type": "string", "minLength": 1 },
                  "api_version": { "type": "string", "minLength": 1 }
                }
              },
              "dbMigration": {
                "type": "object",
                "required": ["service_name", "organization", "tool"],
                "additionalProperties": false,
                "properties": {
                  "service_name": { "type": "string", "minLength": 1 },
                  "organization": { "type": "string" },
                  "tool": { "type": "string", "enum": ["alembic", "flyway", "atlas"] }
                }
              },
              "appService": {
                "type": "object",
                "required": [
                  "service_name",
                  "owner",
                  "port",
                  "runtime",
                  "layout",
                  "include_helm_reference"
                ],
                "additionalProperties": false,
                "properties": {
                  "service_name": { "type": "string", "minLength": 1 },
                  "owner": { "type": "string", "minLength": 1 },
                  "port": { "type": "string" },
                  "runtime": {
                    "type": "string",
                    "enum": ["python", "go", "nodejs", "java", "dotnet"]
                  },
                  "layout": {
                    "type": "string",
                    "enum": ["http-api", "worker", "scheduled-job", "grpc"]
                  },
                  "include_helm_reference": { "type": "string" },
                  "helm_chart_repo": { "type": "string" }
                }
              },
              "gitopsDeployment": {
                "type": "object",
                "required": [
                  "service_name",
                  "environment",
                  "gitops_engine",
                  "chart_repo_url",
                  "chart_name",
                  "chart_version",
                  "target_namespace",
                  "sync_policy"
                ],
                "additionalProperties": false,
                "properties": {
                  "service_name": { "type": "string", "minLength": 1 },
                  "environment": { "type": "string", "minLength": 1 },
                  "gitops_engine": { "type": "string", "enum": ["argocd", "flux"] },
                  "chart_repo_url": { "type": "string", "minLength": 1 },
                  "chart_name": { "type": "string", "minLength": 1 },
                  "chart_version": { "type": "string", "minLength": 1 },
                  "target_namespace": { "type": "string", "minLength": 1 },
                  "sync_policy": { "type": "string", "enum": ["manual", "automated"] },
                  "destination_server": { "type": "string" },
                  "argocd_project": { "type": "string" },
                  "flux_source_name": { "type": "string" },
                  "flux_source_namespace": { "type": "string" }
                }
              },
              "githubRepository": {
                "type": "object",
                "required": ["repo_name", "create_mode", "visibility"],
                "additionalProperties": false,
                "properties": {
                  "repo_name": { "type": "string", "minLength": 1 },
                  "create_mode": { "type": "string", "enum": ["template", "selection"] },
                  "visibility": {
                    "type": "string",
                    "enum": ["public", "private", "internal"]
                  },
                  "description": { "type": "string" },
                  "topics": { "type": "string" },
                  "template_owner": { "type": "string" },
                  "template_repo": { "type": "string" },
                  "team_slugs": { "type": "string" },
                  "team_permission": {
                    "type": "string",
                    "enum": ["pull", "triage", "push", "maintain", "admin"]
                  },
                  "default_branch": { "type": "string" },
                  "ruleset_profile": {
                    "type": "string",
                    "enum": ["none", "default-pr"]
                  },
                  "membership_source_team": { "type": "string" },
                  "sync_team_membership": { "type": ["string", "boolean"] }
                }
              },
              "observability": {
                "type": "object",
                "required": [
                  "service_name",
                  "organization",
                  "team",
                  "backend",
                  "output_mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "service_name": { "type": "string", "minLength": 1 },
                  "organization": { "type": "string", "minLength": 1 },
                  "team": { "type": "string", "minLength": 1 },
                  "backend": { "type": "string" },
                  "output_mode": { "type": "string" },
                  "environment": { "type": "string" },
                  "notification_source": { "type": "string" },
                  "notification_target": { "type": "string" },
                  "runbook_url": { "type": "string" },
                  "slo_target_percent": { "type": "string" },
                  "focus": { "type": "string" }
                }
              }
            }
          }
        },
        "ci": {
          "type": "object",
          "required": ["gates", "workflow", "toolchain"],
          "additionalProperties": false,
          "properties": {
            "gates": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "gate_config": {
              "type": "object",
              "additionalProperties": true
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "toolchain": {
              "type": "object",
              "required": ["terraform", "tflint", "checkov"],
              "additionalProperties": false,
              "properties": {
                "terraform": { "type": "string" },
                "tflint": { "type": "string" },
                "checkov": { "type": "string" },
                "infracost": { "type": "string" }
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "required": ["profile", "pack_source", "enabled_rules"],
          "additionalProperties": false,
          "properties": {
            "profile": { "type": "string" },
            "pack_source": { "type": "string" },
            "enabled_rules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "pack_versions": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "terraformModule": {
          "type": "object",
          "required": ["module_name", "cloud_provider"],
          "additionalProperties": false,
          "properties": {
            "module_name": { "type": "string" },
            "cloud_provider": { "type": "string" },
            "provider_services": {
              "type": "array",
              "items": { "type": "string" }
            },
            "provider_service": {
              "type": "string",
              "minLength": 1,
              "description": "Single-resource layout: one provider service from the catalog."
            },
            "provider_resource": {
              "type": "string",
              "minLength": 1,
              "description": "Single-resource layout: one resource type within provider_service."
            }
          }
        },
        "terraformEnvironmentStack": {
          "type": "object",
          "required": ["stack_name", "cloud_provider", "environment", "pinned_modules"],
          "additionalProperties": false,
          "properties": {
            "stack_name": { "type": "string", "minLength": 1 },
            "cloud_provider": { "type": "string" },
            "environment": { "type": "string" },
            "pinned_modules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "source"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "source": { "type": "string", "minLength": 1 },
                  "version": { "type": "string" },
                  "repo_name": { "type": "string" }
                }
              }
            }
          }
        },
        "ansibleRole": {
          "type": "object",
          "required": ["role_name", "namespace"],
          "additionalProperties": false,
          "properties": {
            "role_name": { "type": "string" },
            "namespace": { "type": "string" },
            "min_ansible_version": { "type": "string" },
            "target_platforms": { "type": "string" },
            "role_pattern_source": { "type": "string" },
            "required_collections": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "ansiblePlaybookProject": {
          "type": "object",
          "required": ["project_name", "environment"],
          "additionalProperties": false,
          "properties": {
            "project_name": { "type": "string", "minLength": 1 },
            "environment": { "type": "string" },
            "min_ansible_version": { "type": "string" },
            "pinned_roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["galaxy_name", "version", "src"],
                "additionalProperties": false,
                "properties": {
                  "galaxy_name": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "src": { "type": "string", "minLength": 1 },
                  "repo_name": { "type": "string" }
                }
              }
            },
            "playbook_pattern_source": { "type": "string" },
            "required_collections": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "ansibleCollection": {
          "type": "object",
          "required": ["namespace", "collection_name"],
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "collection_name": { "type": "string", "minLength": 1 },
            "min_ansible_version": { "type": "string" },
            "sample_role_name": { "type": "string" },
            "sample_role_pattern_source": { "type": "string" },
            "required_collections": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "observability": {
          "type": "object",
          "required": ["service_name", "organization", "team", "backend", "output_mode"],
          "additionalProperties": false,
          "properties": {
            "service_name": { "type": "string", "minLength": 1 },
            "organization": { "type": "string", "minLength": 1 },
            "team": { "type": "string", "minLength": 1 },
            "backend": { "type": "string" },
            "output_mode": { "type": "string" },
            "environment": { "type": "string" },
            "notification_source": { "type": "string" },
            "notification_target": { "type": "string" },
            "runbook_url": { "type": "string", "minLength": 1 },
            "slo_target_percent": { "type": "string" },
            "focus": { "type": "string" },
            "datasource_uid": { "type": "string" },
            "dashboard_pack_source": { "type": "string" },
            "monitor_pack_source": { "type": "string" },
            "configuration_mode": { "type": "string" }
          }
        },
        "helmChart": {
          "type": "object",
          "required": ["chart_name", "app_name", "image_repository", "image_tag", "service_type", "enable_ingress"],
          "additionalProperties": false,
          "properties": {
            "chart_name": { "type": "string", "minLength": 1 },
            "app_name": { "type": "string", "minLength": 1 },
            "image_repository": { "type": "string", "minLength": 1 },
            "image_tag": { "type": "string" },
            "service_type": { "type": "string" },
            "enable_ingress": { "type": "string" },
            "ingress_host": { "type": "string" }
          }
        },
        "apiContract": {
          "type": "object",
          "required": ["spec_name", "organization", "spec_kind", "api_title", "api_version"],
          "additionalProperties": false,
          "properties": {
            "spec_name": { "type": "string", "minLength": 1 },
            "organization": { "type": "string" },
            "spec_kind": { "type": "string", "enum": ["openapi", "asyncapi"] },
            "api_title": { "type": "string", "minLength": 1 },
            "api_version": { "type": "string", "minLength": 1 }
          }
        },
        "dbMigration": {
          "type": "object",
          "required": ["service_name", "organization", "tool"],
          "additionalProperties": false,
          "properties": {
            "service_name": { "type": "string", "minLength": 1 },
            "organization": { "type": "string" },
            "tool": { "type": "string", "enum": ["alembic", "flyway", "atlas"] }
          }
        },
        "gitopsDeployment": {
          "type": "object",
          "required": [
            "service_name",
            "environment",
            "gitops_engine",
            "chart_repo_url",
            "chart_name",
            "chart_version",
            "target_namespace",
            "sync_policy"
          ],
          "additionalProperties": false,
          "properties": {
            "service_name": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "gitops_engine": { "type": "string", "enum": ["argocd", "flux"] },
            "chart_repo_url": { "type": "string", "minLength": 1 },
            "chart_name": { "type": "string", "minLength": 1 },
            "chart_version": { "type": "string", "minLength": 1 },
            "target_namespace": { "type": "string", "minLength": 1 },
            "sync_policy": { "type": "string", "enum": ["manual", "automated"] },
            "destination_server": { "type": "string" },
            "argocd_project": { "type": "string" },
            "flux_source_name": { "type": "string" },
            "flux_source_namespace": { "type": "string" }
          }
        },
        "githubRepository": {
          "type": "object",
          "required": ["repo_name", "create_mode", "visibility"],
          "additionalProperties": false,
          "properties": {
            "repo_name": { "type": "string", "minLength": 1 },
            "create_mode": { "type": "string", "enum": ["template", "selection"] },
            "visibility": { "type": "string", "enum": ["public", "private", "internal"] },
            "description": { "type": "string" },
            "topics": { "type": "string" },
            "template_owner": { "type": "string" },
            "template_repo": { "type": "string" },
            "team_slugs": { "type": "string" },
            "team_permission": {
              "type": "string",
              "enum": ["pull", "triage", "push", "maintain", "admin"]
            },
            "default_branch": { "type": "string" },
            "ruleset_profile": {
              "type": "string",
              "enum": ["none", "default-pr"]
            },
            "membership_source_team": { "type": "string" },
            "sync_team_membership": { "type": ["string", "boolean"] }
          }
        },
        "appService": {
          "type": "object",
          "required": ["service_name", "owner", "port", "runtime", "layout", "include_helm_reference"],
          "additionalProperties": false,
          "properties": {
            "service_name": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 },
            "port": { "type": "string" },
            "runtime": {
              "type": "string",
              "enum": ["python", "go", "nodejs", "java", "dotnet"]
            },
            "layout": {
              "type": "string",
              "enum": ["http-api", "worker", "scheduled-job", "grpc"]
            },
            "include_helm_reference": { "type": "string" },
            "helm_chart_repo": { "type": "string" }
          }
        },
        "opaPolicy": {
          "type": "object",
          "required": ["policy_name"],
          "additionalProperties": false,
          "properties": {
            "policy_name": { "type": "string", "minLength": 1 },
            "organization": { "type": "string" }
          }
        },
        "checkovPolicy": {
          "type": "object",
          "required": ["policy_name"],
          "additionalProperties": false,
          "properties": {
            "policy_name": { "type": "string", "minLength": 1 },
            "organization": { "type": "string" }
          }
        },
        "azurePolicy": {
          "type": "object",
          "required": ["policy_name"],
          "additionalProperties": false,
          "properties": {
            "policy_name": { "type": "string", "minLength": 1 },
            "organization": { "type": "string" }
          }
        },
        "azurePolicyDefinitions": {
          "type": "object",
          "required": ["definitions_source", "policy_version"],
          "additionalProperties": false,
          "properties": {
            "definitions_source": { "type": "string" },
            "policy_version": { "type": "string" }
          }
        },
        "checkov": {
          "type": "object",
          "required": ["policies_source", "policy_version"],
          "additionalProperties": false,
          "properties": {
            "policies_source": { "type": "string" },
            "policy_version": { "type": "string" }
          }
        },
        "opa": {
          "type": "object",
          "required": ["policies_source", "policy_version"],
          "additionalProperties": false,
          "properties": {
            "policies_source": { "type": "string" },
            "policy_version": { "type": "string" }
          }
        },
        "ansibleLint": {
          "type": "object",
          "required": ["pack_source", "pack_version"],
          "additionalProperties": false,
          "properties": {
            "pack_source": { "type": "string" },
            "pack_version": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifactType": { "const": "terraform-module" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["terraformModule"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "terraform-environment-stack" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["terraformEnvironmentStack"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "ansible-playbook-project" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["ansiblePlaybookProject"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "ansible-role" }
            },
            "required": ["artifactType"]
          },
          "then": {
            "required": ["ansibleRole"]
          }
        },
        {
          "if": {
            "properties": {
              "artifactType": { "const": "ansible-collection" }
            },
