{
  "title": "Repave generation",
  "uid": "repave-gen",
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "type": "timeseries",
      "title": "Generations per minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(repave_generations_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 generation duration (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(repave_generation_seconds_bucket[5m])) by (le, blueprint))",
          "legendFormat": "{{blueprint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Async run queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "repave_run_queue_inflight",
          "legendFormat": "inflight"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Async runs per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(repave_async_runs_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
