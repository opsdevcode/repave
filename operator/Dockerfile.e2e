# E2E image: operator manager + repave CLI and monorepo blueprint checkout.
# Build from repository root:
#   docker build -f operator/Dockerfile.e2e -t repave-operator:dev .
#
# syntax=docker/dockerfile:1

FROM golang:1.23 AS operator-build
WORKDIR /workspace/operator
COPY operator/go.mod operator/go.sum ./
RUN go mod download
COPY operator/ .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -o /manager cmd/main.go

FROM python:3.12-slim AS engine-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /repave/engine
COPY engine/pyproject.toml engine/uv.lock ./
COPY engine/src ./src
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev

FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 65532 nonroot \
    && useradd -u 65532 -g nonroot -M nonroot

COPY --from=operator-build /manager /manager
COPY --from=engine-build /repave/engine /repave/engine
COPY blueprints /repave/blueprints
COPY schemas /repave/schemas
COPY standards /repave/standards
COPY policy /repave/policy

ENV REPAVE_REPO_ROOT=/repave
ENV REPAVE_CLI=/repave/engine/.venv/bin/repave
ENV PATH="/repave/engine/.venv/bin:${PATH}"

USER 65532:65532
ENTRYPOINT ["/manager"]
