{
  "title": "Kubernetes / Views / Pods (Grafana.com #15760 fork)",
  "uid": "community_k8s_pods_15760",
  "tags": [
    "service:{{ service_name }}",
    "team:{{ team }}",
    "org:{{ organization }}",
    "env:{{ environment }}",
    "managed-by:repave",
    "community:grafana-15760"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "description": "Starter fork inspired by Grafana.com dashboard 15760 (Kubernetes / Views / Pods).",
  "panels": [
    {
      "type": "text",
      "title": "Community attribution",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Upstream:** [Grafana.com dashboard 15760](https://grafana.com/grafana/dashboards/15760). Filter kube-state-metrics / cAdvisor queries to namespace or workload labels for **{{ service_name }}**."
      }
    },
    {
      "type": "timeseries",
      "title": "Pod restarts",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "{{ datasource_uid }}" },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\".*{{ service_name }}.*\",environment=\"$environment\"}[1h])) by (pod)",
          "legendFormat": "{% raw %}{{pod}}{% endraw %}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "{{ environment }}",
        "current": { "text": "{{ environment }}", "value": "{{ environment }}" }
      }
    ]
  }
}
