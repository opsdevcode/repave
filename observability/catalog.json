{
  "version": "1.5.0",
  "defaults": {
    "notification_source": "repave-estate-oncall",
    "notification_target": "pagerduty-platform-primary",
    "dashboard_pack_source": "repave-red-starter",
    "monitor_pack_source": "repave-red-starter",
    "organization": "platform",
    "team": "payments",
    "service_name": "checkout",
    "environment": "prod",
    "datasource_uid": "prometheus",
    "runbook_url": "https://wiki.example.com/runbooks/checkout",
    "slo_target_percent": "99.9"
  },
  "organizations": [
    { "id": "platform", "label": "Platform engineering" },
    { "id": "data", "label": "Data platform" },
    { "id": "retail", "label": "Retail technology" }
  ],
  "teams": [
    { "id": "payments", "label": "Payments", "organization": "platform" },
    { "id": "identity", "label": "Identity", "organization": "platform" },
    { "id": "pipelines", "label": "Data pipelines", "organization": "data" },
    { "id": "storefront", "label": "Storefront", "organization": "retail" }
  ],
  "environments": [
    { "id": "prod", "label": "Production" },
    { "id": "staging", "label": "Staging" },
    { "id": "dev", "label": "Development" },
    { "id": "qa", "label": "QA" }
  ],
  "services": [
    {
      "id": "checkout",
      "label": "Checkout API",
      "organization": "platform",
      "team": "payments",
      "description": "Customer checkout and cart API",
      "runbook_url": "https://wiki.example.com/runbooks/checkout"
    },
    {
      "id": "billing",
      "label": "Billing worker",
      "organization": "platform",
      "team": "payments",
      "description": "Subscription billing and invoicing",
      "runbook_url": "https://wiki.example.com/runbooks/billing"
    },
    {
      "id": "auth",
      "label": "Auth service",
      "organization": "platform",
      "team": "identity",
      "description": "OAuth and session service",
      "runbook_url": "https://wiki.example.com/runbooks/auth"
    }
  ],
  "grafana_datasources": [
    { "uid": "prometheus", "label": "Prometheus (default)", "type": "prometheus" },
    { "uid": "mimir", "label": "Grafana Mimir", "type": "prometheus" },
    { "uid": "thanos", "label": "Thanos", "type": "prometheus" },
    { "uid": "grafanacloud-prom", "label": "Grafana Cloud Prometheus", "type": "prometheus" }
  ],
  "runbooks": [
    {
      "id": "checkout",
      "label": "Checkout runbook",
      "url": "https://wiki.example.com/runbooks/checkout"
    },
    {
      "id": "billing",
      "label": "Billing runbook",
      "url": "https://wiki.example.com/runbooks/billing"
    },
    {
      "id": "auth",
      "label": "Auth runbook",
      "url": "https://wiki.example.com/runbooks/auth"
    },
    {
      "id": "platform-generic",
      "label": "Platform generic incident",
      "url": "https://wiki.example.com/runbooks/platform"
    }
  ],
  "slo_targets": [
    { "id": "none", "label": "No SLO rules", "value": "" },
    { "id": "99.9", "label": "99.9% availability", "value": "99.9" },
    { "id": "99.95", "label": "99.95% availability", "value": "99.95" },
    { "id": "99.99", "label": "99.99% availability", "value": "99.99" }
  ],
  "notification_sources": [
    {
      "id": "repave-estate-oncall",
      "label": "Estate on-call (PagerDuty)",
      "description": "Platform-curated PagerDuty services for golden-path repos.",
      "provider": "pagerduty",
      "reference_url": "https://github.com/opsdevcode/repave/tree/main/observability",
      "targets": [
        {
          "id": "pagerduty-platform-primary",
          "label": "Platform primary",
          "description": "Default platform incident routing."
        },
        {
          "id": "pagerduty-payments",
          "label": "Payments on-call",
          "description": "Checkout and billing services."
        },
        {
          "id": "pagerduty-data",
          "label": "Data platform",
          "description": "Pipelines, warehouses, and batch jobs."
        }
      ]
    },
    {
      "id": "repave-slack-alerts",
      "label": "Slack alert channels",
      "description": "Named Slack destinations wired in Alertmanager stubs when selected.",
      "provider": "slack",
      "targets": [
        {
          "id": "slack-alerts-platform",
          "label": "#alerts-platform",
          "description": "Shared platform alert channel."
        },
        {
          "id": "slack-alerts-payments",
          "label": "#alerts-payments",
          "description": "Payments team alert channel."
        }
      ]
    },
    {
      "id": "repave-email-escalation",
      "label": "Email escalation",
      "description": "Mailing lists for low-urgency or compliance routing.",
      "provider": "email",
      "targets": [
        {
          "id": "email-platform-oncall",
          "label": "platform-oncall@example.com",
          "description": "Platform on-call mailing list."
        }
      ]
    }
  ],
  "form_presets": {
    "dashboards-as-code-generic": {
      "decision_fields": [
        "configuration_mode",
        "service_name",
        "backend",
        "dashboard_pack_source"
      ]
    },
    "observability-as-code-generic": {
      "decision_fields": ["configuration_mode", "service_name", "backend"]
    },
    "monitors-as-code-generic": {
      "decision_fields": [
        "configuration_mode",
        "service_name",
        "backend",
        "monitor_pack_source"
      ]
    }
  },
  "dashboard_packs": [
    {
      "id": "repave-red-starter",
      "label": "Platform baseline only",
      "backend": "any",
      "description": "Service overview and golden signals (rate, errors, duration) from the template—no extra community dashboards.",
      "reference_url": "https://github.com/opsdevcode/repave/tree/main/standards/observability/dashboards-as-code.md",
      "files": []
    },
    {
      "id": "grafana-red-plus-node-exporter-1860",
      "label": "Baseline + Node Exporter Full (Grafana #1860)",
      "backend": "grafana",
      "description": "Platform baseline dashboards plus a vendored fork of Grafana.com dashboard 1860 (MIT).",
      "reference_url": "https://grafana.com/grafana/dashboards/1860",
      "license": "MIT",
      "files": [
        {
          "source": "dashboards/grafana/community/node-exporter-1860.json.jinja",
          "dest": "grafana/dashboards/community-node-exporter-1860.json"
        }
      ]
    },
    {
      "id": "grafana-red-plus-k8s-pods-15760",
      "label": "Baseline + Kubernetes pods (Grafana #15760)",
      "backend": "grafana",
      "description": "Platform baseline dashboards plus a vendored fork inspired by Grafana.com dashboard 15760.",
      "reference_url": "https://grafana.com/grafana/dashboards/15760",
      "license": "Apache-2.0",
      "files": [
        {
          "source": "dashboards/grafana/community/k8s-pods-15760.json.jinja",
          "dest": "grafana/dashboards/community-k8s-pods-15760.json"
        }
      ]
    },
    {
      "id": "datadog-red-plus-apm-service",
      "label": "Baseline + Datadog APM service layout",
      "backend": "datadog",
      "description": "Platform baseline dashboards plus a Datadog APM-style community layout fork.",
      "reference_url": "https://docs.datadoghq.com/tracing/services/service_page/",
      "files": [
        {
          "source": "dashboards/datadog/community/apm-service.json.jinja",
          "dest": "datadog/dashboards/community-apm-service.json"
        }
      ]
    }
  ],
  "monitor_packs": [
    {
      "id": "repave-red-starter",
      "label": "Platform baseline only",
      "backend": "any",
      "description": "Service down and optional SLO burn rules from the template—no extra community monitors.",
      "reference_url": "https://github.com/opsdevcode/repave/tree/main/standards/observability/monitors-as-code.md",
      "files": []
    },
    {
      "id": "prometheus-red-plus-host-cpu",
      "label": "Baseline + host CPU saturation",
      "backend": "prometheus",
      "description": "Platform baseline alerts plus a vendored host CPU warning rule (node_exporter).",
      "reference_url": "https://github.com/opsdevcode/repave/tree/main/observability/monitors",
      "files": [
        {
          "source": "monitors/prometheus/community/host-cpu.yaml.jinja",
          "dest": "prometheus/rules/community-host-cpu.yaml"
        }
      ]
    },
    {
      "id": "datadog-red-plus-apm-errors",
      "label": "Baseline + APM error-rate monitor",
      "backend": "datadog",
      "description": "Platform baseline monitors plus a Datadog APM-style error-rate layout fork.",
      "reference_url": "https://docs.datadoghq.com/tracing/services/service_page/",
      "files": [
        {
          "source": "monitors/datadog/community/apm-error-rate.json.jinja",
          "dest": "datadog/monitors/community-apm-error-rate.json"
        }
      ]
    }
  ]
}
