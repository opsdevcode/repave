name: repave gates
on:
  push:
    branches: [main, master]
  pull_request:

permissions:
  contents: read

jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"
      - name: Install repave-engine
        run: pip install "repave-engine=={{ engine_version }}"
{% if needs_terraform %}
      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "{{ terraform_version }}"
{% endif %}{% if needs_tflint %}
      - name: Set up TFLint
        uses: terraform-linters/setup-tflint@v4
        with:
          tflint_version: "{{ tflint_version }}"
{% endif %}{% if needs_checkov %}
      - name: Install Checkov
        run: pip install "{{ checkov_spec }}"
{% endif %}{% if needs_yamllint %}
      - name: Install yamllint
        run: pip install yamllint
{% endif %}{% if needs_helm %}
      - name: Set up Helm
        uses: azure/setup-helm@v4
        with:
          version: "{{ helm_version }}"
{% endif %}{% if needs_ansible %}
      - name: Install Ansible tooling
        run: pip install ansible ansible-lint
{% endif %}{% if needs_conftest %}
      - name: Install Conftest
        run: |
          CONFTEST_URL="https://github.com/open-policy-agent/conftest/releases/download/v{{ conftest_version }}/conftest_{{ conftest_version }}_Linux_x86_64.tar.gz"
          curl -sSL "$CONFTEST_URL" | tar xz -C /usr/local/bin conftest
{% endif %}{% if needs_promtool %}
      - name: Install Promtool
        run: |
          PROM_URL="https://github.com/prometheus/prometheus/releases/download/v{{ prometheus_version }}/prometheus-{{ prometheus_version }}.linux-amd64.tar.gz"
          curl -sSL "$PROM_URL" \
            | tar xz --strip-components=1 -C /usr/local/bin \
              prometheus-{{ prometheus_version }}.linux-amd64/promtool
{% endif %}{% if needs_amtool %}
      - name: Install amtool
        run: |
          AM_URL="https://github.com/prometheus/alertmanager/releases/download/v{{ alertmanager_version }}/alertmanager-{{ alertmanager_version }}.linux-amd64.tar.gz"
          curl -sSL "$AM_URL" \
            | tar xz --strip-components=1 -C /usr/local/bin \
              alertmanager-{{ alertmanager_version }}.linux-amd64/amtool
{% endif %}{% if needs_molecule %}
      - name: Molecule (Docker)
        run: pip install molecule molecule-plugins[docker] docker
{% endif %}{% if needs_hadolint %}
      - name: Install Hadolint
        run: |
          curl -sSL -o /usr/local/bin/hadolint \
            "https://github.com/hadolint/hadolint/releases/download/v{{ hadolint_version }}/hadolint-Linux-x86_64"
          chmod +x /usr/local/bin/hadolint
{% endif %}{% if needs_go %}
      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: "{{ go_version }}"
{% endif %}{% if needs_python %}
      - name: Install service dev dependencies
        run: pip install -e ".[dev]"
{% endif %}
      - name: Run golden path gates
        run: repave gates --path .
{% if needs_datadog_api %}
        env:
{% raw %}
          DD_API_KEY: ${{ secrets.DD_API_KEY }}
          DD_APP_KEY: ${{ secrets.DD_APP_KEY }}
{% endraw %}
{% endif %}
