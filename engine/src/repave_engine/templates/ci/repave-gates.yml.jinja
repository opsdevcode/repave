name: repave gates
on:
  push:
    branches: [main, master]
  pull_request:

permissions:
  contents: read

jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      - uses: {{ actions['actions/checkout'].ref }}  # {{ actions['actions/checkout'].tag }}
      - name: Set up Python
        uses: {{ actions['actions/setup-python'].ref }}  # {{ actions['actions/setup-python'].tag }}
        with:
          python-version: "{{ python_version }}"
      - name: Install repave-engine
        run: pip install "repave-engine=={{ engine_version }}"
{% if needs_terraform %}
      - name: Set up Terraform
        uses: {{ actions['hashicorp/setup-terraform'].ref }}  # {{ actions['hashicorp/setup-terraform'].tag }}
        with:
          terraform_version: "{{ terraform_version }}"
{% endif %}{% if needs_tflint %}
      - name: Set up TFLint
        uses: {{ actions['terraform-linters/setup-tflint'].ref }}  # {{ actions['terraform-linters/setup-tflint'].tag }}
        with:
          tflint_version: "{{ tflint_version }}"
{% endif %}{% if needs_checkov %}
      - name: Install Checkov
        run: pip install "{{ checkov_spec }}"
{% endif %}{% if needs_infracost %}
      - name: Install Infracost
        run: |
          curl -sSL -o /tmp/infracost.tgz \
            "https://github.com/infracost/cli/releases/download/v{{ infracost_version }}/infracost-linux-amd64.tar.gz"
          tar xzf /tmp/infracost.tgz -C /usr/local/bin infracost
          chmod +x /usr/local/bin/infracost
{% endif %}{% if needs_yamllint %}
      - name: Install yamllint
        run: pip install yamllint
{% endif %}{% if needs_helm %}
      - name: Set up Helm
        uses: {{ actions['azure/setup-helm'].ref }}  # {{ actions['azure/setup-helm'].tag }}
        with:
          version: "{{ helm_version }}"
{% endif %}{% if needs_ansible %}
      - name: Install Ansible tooling
        run: pip install ansible ansible-lint
{% endif %}{% if needs_ansible_collections %}
      - name: Install Ansible collections
        run: |
          if [ -f requirements.yml ]; then
            ansible-galaxy collection install -r requirements.yml
          fi
{% endif %}{% if needs_conftest %}
      - name: Install Conftest
        run: |
          CONFTEST_URL="https://github.com/open-policy-agent/conftest/releases/download/v{{ conftest_version }}/conftest_{{ conftest_version }}_Linux_x86_64.tar.gz"
          curl -sSL "$CONFTEST_URL" | tar xz -C /usr/local/bin conftest
{% endif %}{% if needs_promtool %}
      - name: Install Promtool
        run: |
          PROM_URL="https://github.com/prometheus/prometheus/releases/download/v{{ prometheus_version }}/prometheus-{{ prometheus_version }}.linux-amd64.tar.gz"
          curl -sSL "$PROM_URL" \
            | tar xz --strip-components=1 -C /usr/local/bin \
              prometheus-{{ prometheus_version }}.linux-amd64/promtool
{% endif %}{% if needs_amtool %}
      - name: Install amtool
        run: |
          AM_URL="https://github.com/prometheus/alertmanager/releases/download/v{{ alertmanager_version }}/alertmanager-{{ alertmanager_version }}.linux-amd64.tar.gz"
          curl -sSL "$AM_URL" \
            | tar xz --strip-components=1 -C /usr/local/bin \
              alertmanager-{{ alertmanager_version }}.linux-amd64/amtool
{% endif %}{% if needs_molecule %}
      - name: Molecule (Docker)
        run: pip install molecule molecule-plugins[docker] docker
{% endif %}{% if needs_hadolint %}
      - name: Install Hadolint
        run: |
          curl -sSL -o /usr/local/bin/hadolint \
            "https://github.com/hadolint/hadolint/releases/download/v{{ hadolint_version }}/hadolint-Linux-x86_64"
          chmod +x /usr/local/bin/hadolint
{% endif %}{% if needs_actionlint %}
      - name: Install actionlint
        run: |
          curl -sSL \
            "https://github.com/rhysd/actionlint/releases/download/v{{ actionlint_version }}/actionlint_{{ actionlint_version }}_linux_amd64.tar.gz" \
            | tar xz -C /usr/local/bin actionlint
{% endif %}{% if needs_go %}
      - name: Set up Go
        uses: {{ actions['actions/setup-go'].ref }}  # {{ actions['actions/setup-go'].tag }}
        with:
          go-version: "{{ go_version }}"
{% endif %}{% if needs_node %}
      - name: Set up Node
        uses: {{ actions['actions/setup-node'].ref }}  # {{ actions['actions/setup-node'].tag }}
        with:
          node-version: "{{ node_version }}"
{% endif %}{% if needs_java %}
      - name: Set up Java
        uses: {{ actions['actions/setup-java'].ref }}  # {{ actions['actions/setup-java'].tag }}
        with:
          distribution: temurin
          java-version: "{{ java_version }}"
          cache: maven
{% endif %}{% if needs_dotnet %}
      - name: Set up .NET
        uses: {{ actions['actions/setup-dotnet'].ref }}  # {{ actions['actions/setup-dotnet'].tag }}
        with:
          dotnet-version: "{{ dotnet_version }}"
{% endif %}{% if needs_buf %}
      - name: Install buf
        run: |
          BUF_URL="https://github.com/bufbuild/buf/releases/download/v{{ buf_version }}/buf-Linux-x86_64.tar.gz"
          curl -sSL "$BUF_URL" | tar xz -C /usr/local/bin --strip-components=2 buf/bin/buf
{% endif %}{% if needs_python %}
      - name: Install service dev dependencies
        run: pip install -e ".[dev]"
{% endif %}{% if needs_node %}
      - name: Install Node dev dependencies
        run: npm install
{% endif %}
      - name: Run golden path gates
        run: repave gates --path .
{% if needs_datadog_api or needs_infracost %}
        env:
{% if needs_datadog_api %}
{% raw %}
          DD_API_KEY: ${{ secrets.DD_API_KEY }}
          DD_APP_KEY: ${{ secrets.DD_APP_KEY }}
{% endraw %}
{% endif %}{% if needs_infracost %}
{% raw %}
          INFRACOST_API_KEY: ${{ secrets.INFRACOST_API_KEY }}
{% endraw %}
{% endif %}
{% endif %}
