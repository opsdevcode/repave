# Copy to repave.config.yaml and adjust for your environment.
#
# Local platform console walkthrough (fleet, FinOps, adoption, feedback):
#   make platform-dev-setup && make serve
# See docs/platform-console.md and examples/platform-dev/README.md.
#
# v2 contract: apiVersion identifies the config schema line.
apiVersion: repave.dev/v1
#
# Generated Terraform modules are written to their own git repositories under
# modules_root — never inside the repave platform repository.
# The portal also scans this root for observability-* / dashboards-* repos to
# populate the Service dropdown (see standards/observability/service-registry.md).

output:
  github_org: your-github-org
  modules_root: ../repave-modules
  repo_name_template: "tf-{cloud_provider}-{module_name}"

# Optional portal layout (Backstage-adjacent density without white-label theming).
# portal:
#   density: compact   # default | compact
#   # Template for per-entity dashboard links ({name}, {service}, {entity_id}).
#   observability_dashboard_url: "https://grafana.example.com/d/svc?var-service={name}"
#   # JSON SLO summary URL (same placeholders). Response: status, slo_target, slo_current, detail.
#   observability_slo_url: "https://slo-api.example.com/v1/services/{name}/summary"
#   # JSON cost actuals URL when cost_reader is url (same placeholders).
#   # Response: currency, amount_30d, as_of, detail.
#   cost_actuals_url: "https://cost-api.example.com/v1/services/{name}/summary"
#   # Native readers (server-side, read-only; credentials from the host environment):
#   # cost_reader: aws   # or azure | k8s | focus | url (default url when cost_actuals_url is set)
#   cost_allocation:
#     tag_keys:
#       owner: Owner        # cloud tag key for catalog owner (default Owner)
#       service: Service    # cloud tag key for service name (default Service)
#       environment: Environment
#       cost_center: CostCenter
#   # Override tag key names for all readers: REPAVE_COST_ALLOCATION_TAG_KEYS=owner=Team,service=App
#   # cost_aws:
#   #   tag_key_owner: Owner
#   #   tag_key_service: Service
#   # cost_azure:
#   #   subscription_id: "00000000-0000-0000-0000-000000000000"
#   #   scope: /subscriptions/00000000-0000-0000-0000-000000000000
#   #   tag_key_owner: Owner
#   #   tag_key_service: Service
#   # cost_k8s:   # OpenCost-compatible in-cluster allocation API
#   #   base_url: http://opencost.opencost:9003
#   #   aggregate: label:app.kubernetes.io/name   # or namespace, controller, etc.
#   #   allocation_key: "{name}"   # key in the allocation response map
#   #   window: 30d
#   #   currency: USD
#   # cost_focus:   # FOCUS-shaped billing export (JSON or JSONL path/URL)
#   #   file: data/focus/export.json
#   #   lookback_days: 30
#   #   tag_key_owner: Owner
#   #   tag_key_service: Service
#   # Cost trend sparklines on /library (JSONL snapshots; enabled when cost_reader is set):
#   # cost_snapshots:
#   #   enabled: true
#   #   file: data/fleet/cost-snapshots.jsonl
#   # Monthly budgets for showback (v1.92) — config overrides catalog annotation
#   # repave.dev/monthly-budget-usd on catalog-info.yaml:
#   # cost_budgets:
#   #   default_monthly_usd: 250
#   #   entities:
#   #     opsdevcode-tf-aws-eks-demo: 600
#   # WoW/MoM cost anomaly hooks (v1.94):
#   # cost_anomalies:
#   #   enabled: true
#   #   wow_threshold_pct: 25
#   #   mom_threshold_pct: 50
#   # notifications.events may include finops_anomaly for webhook alerts
#   # Deployment status (ADR 003 Phase 1) — read-only GitOps enrichment on entity detail:
#   # deployment_reader: url   # or argocd | flux
#   # deployment_status_url: "https://status.example/v1/services/{name}"
#   # # Response: sync_status, health, revision, last_synced, detail?, deep_link?
#   # deployment_argocd:
#   #   base_url: https://argocd.example.com
#   #   application: "{name}"
#   # deployment_flux:
#   #   api_server: https://kubernetes.default.svc
#   #   namespace: apps
#   #   name: "{name}"
#   #   kind: kustomization   # or helmrelease
# Or set REPAVE_OBSERVABILITY_DASHBOARD_URL / REPAVE_OBSERVABILITY_SLO_URL /
# REPAVE_COST_ACTUALS_URL / REPAVE_COST_READER / REPAVE_COST_FOCUS_FILE /
# REPAVE_COST_ALLOCATION_TAG_KEYS /
# REPAVE_COST_K8S_BASE_URL /
# REPAVE_DEPLOYMENT_READER / REPAVE_DEPLOYMENT_STATUS_URL /
# REPAVE_ARGOCD_BASE_URL / REPAVE_ARGOCD_TOKEN /
# REPAVE_FLUX_API_SERVER / REPAVE_FLUX_TOKEN.

# Optional hosted service authentication (OIDC). Local dev: leave disabled.
# Auth0 portal access: see docs/auth-service-mode.md and deploy/k8s/chart/values-auth0.yaml
# auth:
#   service_mode: true
#   session_https_only: true
#   oidc:
#     issuer: https://YOUR_TENANT.us.auth0.com/
#     client_id: repave-portal
#     redirect_uri: https://repave.example.com/auth/callback
#     logout_return_to: https://repave.example.com/
#     scopes: [openid, profile, email]
#     groups_claim: groups
#     roles:
#       admin: [repave-admins]
#       generator: [repave-generators]
# Secrets: REPAVE_SESSION_SECRET, REPAVE_OIDC_CLIENT_SECRET
# Optional: REPAVE_SESSION_HTTPS_ONLY=0 for local HTTP testing with service_mode

# Optional gate overrides applied during generation.
gates:
  checkov:
    skip_checks: []
    # Example: skip_checks: ["CKV_AWS_20"]
  policy:
    # Rule IDs that must remain enabled for every generation (platform floor).
    required_rules:
      - checkov:CKV2_REPAVE_1
      - opa:destructive_changes
  # FinOps estimate policy (v1.91). Org floor — injects/requires infracost when
  # the blueprint already has terraform gates (or is a terraform artifact).
  # Env: REPAVE_INFRACOST_REQUIRED=1, REPAVE_INFRACOST_MAX_MONTHLY_USD=500
  # infracost:
  #   required: true
  #   max_monthly_usd: 500

# Optional JSONL audit log for generations (portal and CLI).
# audit:
#   enabled: true
#   file: ../repave-audit/generation.jsonl
# Override path: REPAVE_AUDIT_FILE
# Acting user: REPAVE_ACTING_USER (falls back to USER; OIDC session when auth enabled)

# Optional fleet registry of repositories repave governs (`repave register`, portal fleet API).
# Required for /platform/fleet and catalog entities. See docs/platform-console.md.
# fleet:
#   enabled: true
#   file: ../repave-fleet/registry.jsonl
#   gitops_namespace: repave-system
#   operator_status_file: ../repave-fleet/operator-status.json
# Override path: REPAVE_FLEET_FILE, REPAVE_FLEET_OPERATOR_STATUS_FILE

# Optional golden-path adoption / DX outcome metrics (platform-as-a-product).
# See docs/platform-metrics.md and docs/platform-console.md. Surfaces: /platform/adoption,
# GET /api/v2/platform/metrics, repave metrics adoption, Prometheus gauges (optional).
# platform_metrics:
#   enabled: true
#   snapshot_file: data/platform-metrics/snapshots.jsonl
#   feedback_file: data/platform-metrics/feedback.jsonl
#   github_orgs: [your-github-org]
#   github_topics: []
#   search_limit: 100
#   baseline_adoption_ratio: 0.6
#   baseline_plan_apply_ratio: 0.4
#   # Roadmap evidence loop (v1.89) — /platform/roadmap, GET /api/v2/platform/roadmap-evidence
#   # roadmap_evidence:
#   #   sunset_conversion_threshold: 0.25
#   #   sunset_review_days: 90
#   #   themes:
#   #     - key: v185-adoption
#   #       title: Golden path adoption (v1.85)
#   #       requesting_team: platform
#   #       evidence_kind: fleet_adoption
# Or: REPAVE_PLATFORM_METRICS=1, REPAVE_PLATFORM_METRICS_FILE=..., REPAVE_PLATFORM_FEEDBACK_FILE=...

# Optional async generation queue (see docs/durability.md).
# Hosted service mode (auth.service_mode) REQUIRES database_url — JSONL is export-only.
# durability:
#   async_generation: true
#   max_concurrent_runs: 2
#   queue_max_depth: 32
#   runs_db: data/runs.sqlite
#   require_session_secret: true
#   # Phase 2: unified SQL for runs, audit, and fleet (JSONL export optional):
#   database_url: sqlite:///data/repave.sqlite
#   export_jsonl: true
#   # Phase 3: API enqueues only; workers run `repave run-worker`:
#   worker_mode: external
#   execution_mode: worker
#   max_run_attempts: 3
#   run_stale_seconds: 3600
#   run_retry_base_seconds: 5
# Or: REPAVE_EXECUTION_MODE=worker, REPAVE_DATABASE_URL=..., REPAVE_EXTERNAL_WORKERS=1

# Optional governed live terraform plan (ADR 003 Phase 2). Worker/Job only; plan JSON
# is ephemeral — run results keep resource counts + OPA verdict only.
# live_plan:
#   enabled: true
#   policies_dir: policy/opa/policies
#   environments:
#     # entity_id from the catalog (or "*" fallback):
#     github.com/acme/tf-app:
#       target: https://github.com/acme/tf-app   # or local path
#       secret_name: tf-creds-app                 # K8s Secret envFrom on run Jobs
#       # policies_dir: policy/opa/policies
#       # use_backend: true
# Or: REPAVE_LIVE_PLAN=1

# Optional governed environment vending (ADR 003 Phase 3).
# environment_vending:
#   enabled: true
#   gitops_repo: https://github.com/acme/platform-gitops
#   base_branch: main
#   path_prefix: environments
#   file: data/environments/registry.jsonl
#   default_ttl_hours: 0
#   ttl_hours_by_class:
#     sandbox: 168
#   auto_reclaim_classes:
#     - sandbox
#   decommission_review_classes:
#     - prod
#     - staging
# Or: REPAVE_ENVIRONMENT_VENDING=1, REPAVE_ENVIRONMENT_REGISTRY_FILE=...

# Optional OpenTelemetry trace export for pipeline spans (requires `uv sync --extra otel`).
# tracing:
#   enabled: true
#   otlp_endpoint: http://127.0.0.1:4318
#   service_name: repave-engine
# Or: OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME (see docs/tracing.md)

# Optional outbound notifications (Slack, Teams, or generic webhook).
# Delivery is best-effort and never blocks generation.
# notifications:
#   enabled: true
#   slack_webhook_url: https://hooks.slack.com/services/...
#   teams_webhook_url: https://outlook.office.com/webhook/...
#   webhook_url: https://example.com/repave-events
#   events:
#     - publish_complete
#     - generation_failed
#     - generation_succeeded
#
# Operator drift/remediation (set the same webhook URLs on the operator Deployment):
#   REPAVE_OPERATOR_NOTIFY_ENABLED=true
#   REPAVE_OPERATOR_NOTIFY_EVENTS=drift_detected,remediation_pr_opened,remediation_pr_planned

# Optional governed pull request conventions for generation, import, upgrade, and operator PRs.
# pull_requests:
#   branch_prefix:
#     generate: repave/bootstrap
#     upgrade: repave/upgrade
#     import: repave/import
#   labels: [repave, governed]
#   evidence_checklist: true
# Operator env mirrors: REPAVE_PR_BRANCH_PREFIX_UPGRADE, REPAVE_PR_LABELS, REPAVE_PR_EVIDENCE_CHECKLIST
