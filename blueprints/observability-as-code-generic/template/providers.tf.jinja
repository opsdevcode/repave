{% if backend == 'datadog' %}
provider "datadog" {
  # Credentials are read from DD_API_KEY and DD_APP_KEY in the environment.
  # validate = false allows terraform plan in CI and portal dry-run without keys.
  validate = false
}
{% elif backend == 'grafana' %}
provider "grafana" {
  # Set GRAFANA_AUTH or url/auth via environment; see README.md.
  url = var.grafana_url
}
{% elif backend == 'prometheus' %}
# Prometheus Terraform mode uses null_resource payloads; wire them to your ruler in CI/CD.
{% elif backend == 'otel' %}
provider "helm" {
  # Kubeconfig from environment; see README.md.
}
{% endif %}
