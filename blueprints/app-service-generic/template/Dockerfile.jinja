{% if runtime == 'python' -%}
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml .
COPY src ./src
RUN pip install --no-cache-dir .

{% if layout == 'http-api' -%}
EXPOSE {{ port }}

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "{{ port }}"]
{% elif layout == 'worker' -%}
ENV QUEUE_URL=""

CMD ["python", "-m", "app.main"]
{% elif layout == 'scheduled-job' -%}
CMD ["python", "-m", "app.main"]
{% elif layout == 'grpc' -%}
COPY buf.yaml .
COPY proto ./proto

EXPOSE {{ port }}

CMD ["python", "-m", "app.main"]
{% endif -%}
{% elif runtime == 'go' -%}
FROM golang:1.23-alpine AS build

WORKDIR /app

COPY go.mod ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /server ./cmd/server

FROM gcr.io/distroless/static-debian12

COPY --from=build /server /server

{% if layout == 'http-api' or layout == 'grpc' -%}
EXPOSE {{ port }}
{% endif -%}
{% if layout == 'worker' -%}
ENV QUEUE_URL=""
{% elif layout == 'grpc' -%}
COPY buf.yaml .
COPY proto ./proto
{% endif -%}

USER nonroot:nonroot
ENTRYPOINT ["/server"]
{% elif runtime == 'nodejs' -%}
FROM node:22-slim AS build

WORKDIR /app

COPY package.json tsconfig.json ./
COPY src ./src
COPY test ./test
RUN npm install && npm run lint && npm test && npm run build

FROM node:22-slim

WORKDIR /app

ENV NODE_ENV=production

COPY package.json ./
RUN npm install --omit=dev
COPY --from=build /app/dist ./dist
{% if layout == 'grpc' -%}
COPY buf.yaml .
COPY proto ./proto
{% endif -%}

{% if layout == 'http-api' or layout == 'grpc' -%}
EXPOSE {{ port }}
{% endif -%}
{% if layout == 'worker' -%}
ENV QUEUE_URL=""
{% endif -%}

USER node
CMD ["node", "dist/main.js"]
{% elif runtime == 'java' -%}
FROM eclipse-temurin:21-jdk-noble AS build

WORKDIR /app

COPY pom.xml .
RUN mvn -q dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre-noble

WORKDIR /app

COPY --from=build /app/target/*.jar app.jar
{% if layout == 'grpc' -%}
COPY buf.yaml .
COPY proto ./proto
{% endif -%}

{% if layout == 'http-api' or layout == 'grpc' -%}
EXPOSE {{ port }}
{% endif -%}
{% if layout == 'worker' -%}
ENV QUEUE_URL=""
{% endif -%}

USER 1000
ENTRYPOINT ["java", "-jar", "app.jar"]
{% elif runtime == 'dotnet' -%}
{% set dotnet_project = service_name.replace('-', ' ')|title|replace(' ', '') -%}
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build

WORKDIR /app

COPY App.csproj ./
COPY tests/App.Tests.csproj ./tests/
RUN dotnet restore
COPY . .
RUN dotnet publish App.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble

WORKDIR /app

COPY --from=build /app/publish .
{% if layout == 'grpc' -%}
COPY buf.yaml .
COPY proto ./proto
{% endif -%}

{% if layout == 'http-api' or layout == 'grpc' -%}
EXPOSE {{ port }}
{% endif -%}
{% if layout == 'worker' -%}
ENV QUEUE_URL=""
{% endif -%}

USER $APP_UID
ENTRYPOINT ["dotnet", "{{ dotnet_project }}.dll"]
{% endif %}
