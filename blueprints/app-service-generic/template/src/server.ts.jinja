{% if layout == 'http-api' -%}
// {{ service_name }} — generated by repave app-service-generic.
import http from "node:http";

export function healthPayload(): { status: string } {
  return { status: "ok" };
}

export function createServer(): http.Server {
  return http.createServer((req, res) => {
    if (req.url === "/healthz") {
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify(healthPayload()));
      return;
    }
    res.writeHead(404);
    res.end();
  });
}
{% elif layout == 'worker' -%}
// {{ service_name }} — queue worker generated by repave app-service-generic.

let shutdown = false;

export function processMessage(body: string, idempotencyKey: string): void {
  void idempotencyKey;
  console.log(`processed message: ${body}`);
}

export async function runWorker(pollIntervalMs = 1000): Promise<void> {
  const queueUrl = process.env.QUEUE_URL?.trim() ?? "";
  if (!queueUrl) {
    console.warn("QUEUE_URL is unset; worker polls without consuming");
  }

  const onSignal = () => {
    console.log("draining");
    shutdown = true;
  };
  process.on("SIGTERM", onSignal);
  process.on("SIGINT", onSignal);

  while (!shutdown) {
    if (queueUrl) {
      processMessage("heartbeat", "bootstrap");
    }
    await new Promise((resolve) => setTimeout(resolve, pollIntervalMs));
  }
}
