"""{{ service_name }} — queue worker generated by repave app-service-generic."""

from __future__ import annotations

import logging
import os
import signal
import time

logger = logging.getLogger(__name__)

_shutdown = False


def _handle_shutdown(signum: int, _frame: object) -> None:
    global _shutdown
    logger.info("received signal %s; draining", signum)
    _shutdown = True


def process_message(body: str, *, idempotency_key: str) -> None:
    """Process one queue message idempotently (replace with domain logic)."""
    _ = idempotency_key
    logger.info("processed message: %s", body)


def run_worker(*, poll_interval_seconds: float = 1.0) -> None:
    signal.signal(signal.SIGTERM, _handle_shutdown)
    signal.signal(signal.SIGINT, _handle_shutdown)
    queue_url = os.environ.get("QUEUE_URL", "").strip()
    if not queue_url:
        logger.warning("QUEUE_URL is unset; worker polls without consuming")
    while not _shutdown:
        if queue_url:
            process_message("heartbeat", idempotency_key="bootstrap")
        time.sleep(poll_interval_seconds)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    run_worker()
