public class HealthTests
{
    [Fact]
    public void RunJob_succeeds() => Assert.Equal(0, ScheduledJob.Run());
}
{% elif layout == 'grpc' -%}
public class HealthTests
{
    [Fact]
    public void HealthStatus_is_ok() => Assert.Equal("ok", HealthContract.Status().Status);
}
