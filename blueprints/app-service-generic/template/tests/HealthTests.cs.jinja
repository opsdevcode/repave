using Repave.{{ dotnet_project }};
using Xunit;

namespace Repave.{{ dotnet_project }}.Tests;

{% if layout == 'http-api' -%}
public class HealthTests
{
    [Fact]
    public void Payload_is_ok() => Assert.Equal("ok", Health.Payload().Status);
}
{% elif layout == 'worker' -%}
public class HealthTests
{
