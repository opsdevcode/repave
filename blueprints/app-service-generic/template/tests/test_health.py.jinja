from app.main import process_message


def test_process_message_is_idempotent() -> None:
    process_message("order-1", idempotency_key="key-1")
{% elif layout == 'scheduled-job' -%}
from app.main import run_job


def test_run_job_succeeds() -> None:
    assert run_job() == 0
