{% if layout == 'http-api' -%}
// {{ service_name }} — generated by repave app-service-generic.
package main

import (
	"encoding/json"
	"log"
	"net/http"
)

func main() {
	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", healthz)
	addr := ":{{ port }}"
	log.Printf("listening on %s", addr)
	if err := http.ListenAndServe(addr, mux); err != nil {
		log.Fatal(err)
	}
}

func healthz(w http.ResponseWriter, _ *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok"})
}
{% elif layout == 'worker' -%}
// {{ service_name }} — queue worker generated by repave app-service-generic.
package main

import (
	"log"
	"os"
	"os/signal"
	"syscall"
	"time"
)

func processMessage(body string, idempotencyKey string) {
	_ = idempotencyKey
	log.Printf("processed message: %s", body)
}

func runWorker(pollInterval time.Duration) {
	queueURL := os.Getenv("QUEUE_URL")
	if queueURL == "" {
		log.Print("QUEUE_URL is unset; worker polls without consuming")
	}
	shutdown := make(chan os.Signal, 1)
	signal.Notify(shutdown, syscall.SIGTERM, syscall.SIGINT)

	ticker := time.NewTicker(pollInterval)
	defer ticker.Stop()

	for {
		select {
		case <-shutdown:
			log.Print("draining")
			return
		case <-ticker.C:
			if queueURL != "" {
				processMessage("heartbeat", "bootstrap")
			}
		}
	}
}

func main() {
	runWorker(time.Second)
}
