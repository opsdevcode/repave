{% if runtime == 'python' -%}
[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ service_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.12"
dependencies = [
{% if layout == 'http-api' -%}
  "fastapi>=0.110.0",
  "uvicorn[standard]>=0.27.0",
{% endif -%}
]

[project.optional-dependencies]
dev = [
  "pytest>=8.0",
  "ruff>=0.9.0",
{% if layout == 'http-api' -%}
  "httpx>=0.27.0",
{% endif -%}
]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.ruff]
target-version = "py312"
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.setuptools.packages.find]
where = ["src"]
{% endif -%}
