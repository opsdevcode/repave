{% if cloud_provider == "aws" %}
mock_provider "aws" {}
{% elif cloud_provider == "azure" %}
mock_provider "azurerm" {}
{% elif cloud_provider == "gcp" %}
mock_provider "google" {}
{% endif %}

run "plan_default" {
  command = plan

  assert {
    condition     = length(output.resource_ids) > 0
    error_message = "Expected at least one resource id from the composed module"
  }
}

run "plan_with_overrides" {
  command = plan

  variables {
    environment = "dev"
    tags = {
      owner = "platform-engineering"
    }
  }

  assert {
    condition     = output.environment == "dev"
    error_message = "Expected environment output to match the test input"
  }
}
