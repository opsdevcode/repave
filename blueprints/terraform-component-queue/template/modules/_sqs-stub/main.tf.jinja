variable "stack_name" {
  type = string
}

variable "environment" {
  type = string
}

variable "name_prefix" {
  type    = string
  default = ""
}

variable "tags" {
  type = map(string)
}

{% if cloud_provider == "aws" %}
# Managed queue (SQS). Pin an estate tf-* module before shared apply.
resource "aws_sqs_queue" "this" {
  name                    = replace(var.name_prefix, "_", "-")
  sqs_managed_sse_enabled = true
  tags                    = var.tags
}

output "resource_ids" {
  value = [aws_sqs_queue.this.id]
}
{% elif cloud_provider == "azure" %}
# Managed queue (Service Bus). Pin an estate tf-* module before shared apply.
resource "azurerm_resource_group" "this" {
  name     = replace(var.name_prefix, "_", "-")
  location = "eastus"
  tags     = var.tags
}

resource "azurerm_servicebus_namespace" "this" {
  name                          = replace(var.name_prefix, "_", "-")
  location                      = azurerm_resource_group.this.location
  resource_group_name           = azurerm_resource_group.this.name
  sku                           = "Standard"
  minimum_tls_version           = "1.2"
  local_auth_enabled            = false
  public_network_access_enabled = false
  tags                          = var.tags
}

resource "azurerm_servicebus_queue" "this" {
  name         = replace(var.name_prefix, "_", "-")
  namespace_id = azurerm_servicebus_namespace.this.id
}

output "resource_ids" {
  value = [azurerm_servicebus_queue.this.id]
}
{% elif cloud_provider == "gcp" %}
# Managed queue (Pub/Sub). Pin an estate tf-* module before shared apply.
resource "google_pubsub_topic" "this" {
  name = replace(var.name_prefix, "_", "-")
}

output "resource_ids" {
  value = [google_pubsub_topic.this.id]
}
{% endif %}
