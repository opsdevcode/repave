variable "stack_name" {
  type = string
}

variable "environment" {
  type = string
}

variable "name_prefix" {
  type    = string
  default = ""
}

variable "tags" {
  type = map(string)
}

{% if cloud_provider == "aws" %}
# Managed object bucket (S3). Pin an estate tf-* module before shared apply.
resource "aws_s3_bucket" "this" {
  bucket = replace(var.name_prefix, "_", "-")
  tags   = var.tags
}

resource "aws_s3_bucket_public_access_block" "this" {
  bucket                  = aws_s3_bucket.this.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "this" {
  bucket = aws_s3_bucket.this.id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_versioning" "this" {
  bucket = aws_s3_bucket.this.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "this" {
  bucket = aws_s3_bucket.this.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
    bucket_key_enabled = true
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "this" {
  bucket = aws_s3_bucket.this.id
  rule {
    id     = "abort-incomplete"
    status = "Enabled"
    filter {
      prefix = ""
    }
    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

output "resource_ids" {
  value = [aws_s3_bucket.this.id]
}
{% elif cloud_provider == "azure" %}
# Managed object store (Blob). Pin an estate tf-* module before shared apply.
resource "azurerm_resource_group" "this" {
  name     = replace(var.name_prefix, "_", "-")
  location = "eastus"
  tags     = var.tags
}

resource "azurerm_storage_account" "this" {
  name                            = substr(replace(replace(var.name_prefix, "_", ""), "-", ""), 0, 24)
  resource_group_name             = azurerm_resource_group.this.name
  location                        = azurerm_resource_group.this.location
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  min_tls_version                 = "TLS1_2"
  https_traffic_only_enabled      = true
  allow_nested_items_to_be_public = false
  shared_access_key_enabled       = false
  local_user_enabled              = false
  public_network_access_enabled   = false

  blob_properties {
    versioning_enabled = true
    delete_retention_policy {
      days = 7
    }
  }

  tags = var.tags
}

output "resource_ids" {
  value = [azurerm_storage_account.this.id]
}
{% elif cloud_provider == "gcp" %}
# Managed object bucket (GCS). Pin an estate tf-* module before shared apply.
resource "google_storage_bucket" "this" {
  name                        = replace(var.name_prefix, "_", "-")
  location                    = "US"
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  versioning {
    enabled = true
  }
}

output "resource_ids" {
  value = [google_storage_bucket.this.id]
}
{% endif %}
