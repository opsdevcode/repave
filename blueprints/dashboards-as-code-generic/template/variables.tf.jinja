variable "service_name" {
  type        = string
  description = "Logical service name for dashboard uid and tags."
  default     = "{{ service_name }}"
}

variable "team" {
  type        = string
  description = "Owning team slug."
  default     = "{{ team }}"
}

variable "organization" {
  type        = string
  description = "Organization or business unit slug."
  default     = "{{ organization }}"
}

variable "description" {
  type        = string
  description = "Human-readable scope for dashboards."
  default     = "{{ description | replace('\"', '\\\"') }}"
}

variable "environment" {
  type        = string
  description = "Deployment environment slug for tags."
  default     = "{{ environment }}"
}

variable "notification_target" {
  type        = string
  description = "Catalog notification target documented in README."
  default     = "{{ notification_target }}"
}

{% if backend == 'grafana' %}
variable "grafana_url" {
  type        = string
  description = "Grafana base URL for the Terraform provider."
  default     = "http://localhost:3000"
}
{% endif %}
