variable "module_name" {
  type        = string
  description = "Name of this module instance."
  default     = "{{ module_name }}"
}

variable "cloud_provider" {
  type        = string
  description = "Cloud provider this module targets."
  default     = "{{ cloud_provider }}"
}

variable "provider_services" {
  type        = list(string)
  description = "Provider services in scope for this module."
  default     = ["{{ provider_service }}"]
}

variable "environment" {
  type        = string
  description = "Deployment environment (for example dev, stage, prod)."
  default     = "dev"
}

variable "owner" {
  type        = string
  description = "Owning team for cost allocation (Owner tag)."
  default     = "{{ owner }}"
}

variable "service" {
  type        = string
  description = "Service name for cost allocation (Service tag)."
  default     = "{{ module_name }}"
}

variable "cost_center" {
  type        = string
  description = "Optional cost center for chargeback (CostCenter tag)."
  default     = "{{ cost_center }}"
}

variable "name_prefix" {
  type        = string
  description = "Optional naming prefix; when null, defaults to module_name-environment."
  default     = null
  nullable    = true
}

variable "tags" {
  type        = map(string)
  description = "Resource tags applied by the module."
  default     = {}
}
