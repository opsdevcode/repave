[
  {
    "name": "{{ service_name }} target down",
    "type": "metric alert",
    "query": "avg(last_5m):max:up{service:{{ service_name }}} < 1",
    "message": "{{ service_name }} appears unavailable.\n\nRunbook: {{ runbook_url }}\nNotification: {{ notification_target_label }} ({{ notification_target }})\nNotify: @{{ notification_target }}",
    "tags": [
      "service:{{ service_name }}",
      "team:{{ team }}",
      "org:{{ organization }}",
      "env:{{ environment }}",
      "managed-by:repave"
    ],
    "options": {
      "notify_no_data": true,
      "no_data_timeframe": 10,
      "require_full_window": false,
      "include_tags": true
    }
  }
]
