variable "stack_name" {
  type = string
}

variable "environment" {
  type = string
}

variable "name_prefix" {
  type    = string
  default = ""
}

variable "tags" {
  type = map(string)
}

{% if cloud_provider == "aws" %}
# Managed PostgreSQL (RDS). Pin an estate tf-* module before shared apply.
resource "aws_vpc" "this" {
  cidr_block           = "10.80.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true
  tags                 = var.tags
}

resource "aws_subnet" "a" {
  vpc_id            = aws_vpc.this.id
  cidr_block        = "10.80.1.0/24"
  availability_zone = "us-east-1a"
  tags              = var.tags
}

resource "aws_subnet" "b" {
  vpc_id            = aws_vpc.this.id
  cidr_block        = "10.80.2.0/24"
  availability_zone = "us-east-1b"
  tags              = var.tags
}

resource "aws_db_subnet_group" "this" {
  name       = "${var.name_prefix}-db"
  subnet_ids = [aws_subnet.a.id, aws_subnet.b.id]
  tags       = var.tags
}

resource "aws_security_group" "this" {
  name        = "${var.name_prefix}-db"
  description = "Inbound database access for ${var.stack_name}"
  vpc_id      = aws_vpc.this.id
  tags        = var.tags
}

resource "aws_default_security_group" "this" {
  vpc_id = aws_vpc.this.id
  tags   = var.tags
}

resource "aws_db_parameter_group" "this" {
  name   = "${replace(var.name_prefix, "_", "-")}-pg"
  family = "postgres16"

  parameter {
    name  = "log_statement"
    value = "ddl"
  }

  parameter {
    name  = "log_min_duration_statement"
    value = "1000"
  }

  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }
}

resource "aws_db_instance" "this" {
  identifier                          = replace(var.name_prefix, "_", "-")
  engine                              = "postgres"
  engine_version                      = "16"
  instance_class                      = "db.t3.micro"
  allocated_storage                   = 20
  username                            = "app"
  manage_master_user_password         = true
  storage_encrypted                   = true
  publicly_accessible                 = false
  iam_database_authentication_enabled = true
  backup_retention_period             = 7
  copy_tags_to_snapshot               = true
  auto_minor_version_upgrade          = true
  deletion_protection                 = false
  skip_final_snapshot                 = true
  vpc_security_group_ids              = [aws_security_group.this.id]
  db_subnet_group_name                = aws_db_subnet_group.this.name
  parameter_group_name                = aws_db_parameter_group.this.name
  enabled_cloudwatch_logs_exports     = ["postgresql", "upgrade"]
  tags                                = var.tags
}

output "resource_ids" {
  value = [aws_db_instance.this.id]
}
{% elif cloud_provider == "azure" %}
# Managed PostgreSQL (Flexible Server). Pin an estate tf-* module before shared apply.
resource "azurerm_resource_group" "this" {
  name     = replace(var.name_prefix, "_", "-")
  location = "eastus"
  tags     = var.tags
}

resource "azurerm_postgresql_flexible_server" "this" {
  name                          = replace(var.name_prefix, "_", "-")
  resource_group_name           = azurerm_resource_group.this.name
  location                      = azurerm_resource_group.this.location
  version                       = "16"
  sku_name                      = "B_Standard_B1ms"
  storage_mb                    = 32768
  backup_retention_days         = 7
  geo_redundant_backup_enabled  = false
  public_network_access_enabled = false
  administrator_login           = "psqladmin"

  authentication {
    password_auth_enabled         = false
    active_directory_auth_enabled = true
    tenant_id                     = "11111111-1111-1111-1111-111111111111"
  }

  tags = var.tags
}

output "resource_ids" {
  value = [azurerm_postgresql_flexible_server.this.id]
}
{% elif cloud_provider == "gcp" %}
# Managed PostgreSQL (Cloud SQL). Pin an estate tf-* module before shared apply.
resource "google_sql_database_instance" "this" {
  name                = replace(var.name_prefix, "_", "-")
  database_version    = "POSTGRES_16"
  region              = "us-central1"
  deletion_protection = false

  settings {
    tier              = "db-f1-micro"
    availability_type = "ZONAL"
    disk_autoresize   = true
    backup_configuration {
      enabled                        = true
      point_in_time_recovery_enabled = false
    }
    ip_configuration {
      ipv4_enabled = false
      ssl_mode     = "ENCRYPTED_ONLY"
    }
  }
}

output "resource_ids" {
  value = [google_sql_database_instance.this.id]
}
{% endif %}
