variable "stack_name" {
  type        = string
  description = "Name of this environment stack."
  default     = "{{ stack_name }}"
}

variable "cloud_provider" {
  type        = string
  description = "Cloud provider for this stack."
  default     = "{{ cloud_provider }}"
}

variable "environment" {
  type        = string
  description = "Deployment environment tier."
  default     = "{{ environment }}"
}

variable "owner" {
  type        = string
  description = "Owning team for cost allocation (Owner tag)."
  default     = "{{ owner }}"
}

variable "service" {
  type        = string
  description = "Service name for cost allocation (Service tag)."
  default     = "{{ stack_name }}"
}

variable "cost_center" {
  type        = string
  description = "Optional cost center for chargeback (CostCenter tag)."
  default     = "{{ cost_center }}"
}

variable "tags" {
  type        = map(string)
  description = "Additional resource tags."
  default     = {}
}
