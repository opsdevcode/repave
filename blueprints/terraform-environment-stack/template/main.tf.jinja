{% for mod in pinned_modules %}
# Pinned module — update source/version via requirements or portal inventory.
module "{{ mod.name }}" {
  source = "{{ mod.source }}"
{% if mod.version %}
  version = "{{ mod.version }}"
{% endif %}

  stack_name   = var.stack_name
  environment  = var.environment
  name_prefix  = local.name_prefix
  tags         = local.common_tags
}
{% endfor %}
